# Template only: replace STUDY_DOMAIN and certificate paths after OCI inventory and domain verification.
# Included in nginx's http context; never serve repository files as static assets.
limit_req_zone $binary_remote_addr zone=study_auth:10m rate=5r/m;
server {
    listen 80;
    server_name STUDY_DOMAIN;
    return 308 https://STUDY_DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name STUDY_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/STUDY_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/STUDY_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ~ ^/api/(register|login)$ {
        limit_req zone=study_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_request_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8090;
    }
    location / {
        proxy_request_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8090;
    }
}
